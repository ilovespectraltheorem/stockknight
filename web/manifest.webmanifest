{
  "name": "Maki",
  "short_name": "Maki",
  "description": "Maki is chess on a 6×6 board where you keep pieces in reserve and drop them onto any empty square. Play the Stockhorse engine or a friend, learn as you play, and review every game.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1d2127",
  "theme_color": "#1d2127",
  "icons": [
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [
          ".maki",
          ".txt"
        ]
      }
    }
  ]
}
